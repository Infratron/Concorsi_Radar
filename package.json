{
  "name": "concorsi-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "description": "Radar dei concorsi a premi italiano: ingestione fonti, deduplica, scoring e digest su Telegram (Cloudflare Workers + D1).",
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:cron": "wrangler dev --local --test-scheduled",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create concorsi-radar",
    "db:init": "wrangler d1 execute concorsi-radar --remote --file=./src/db/schema.sql",
    "db:init:local": "wrangler d1 execute concorsi-radar --local --file=./src/db/schema.sql",
    "db:upgrade": "node --experimental-strip-types scripts/db-upgrade.ts",
    "db:sync": "node --experimental-strip-types scripts/db-upgrade.ts --seed",
    "db:seed": "node --experimental-strip-types scripts/seed-sources.ts && wrangler d1 execute concorsi-radar --remote --file=./.wrangler/sources-seed.sql",
    "secrets:token": "wrangler secret put TELEGRAM_BOT_TOKEN",
    "secrets:webhook": "wrangler secret put WEBHOOK_SECRET",
    "secrets:admin": "wrangler secret put ADMIN_CHAT_ID",
    "secrets:chats": "wrangler secret put ALLOWED_CHAT_IDS",
    "db:seed:local": "node --experimental-strip-types scripts/seed-sources.ts && wrangler d1 execute concorsi-radar --local --file=./.wrangler/sources-seed.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "test:sqlite": "vitest run test/d1-sqlite.test.ts test/d1-http.test.ts",
    "test:watch": "vitest",
    "dry-run": "node --experimental-strip-types scripts/dry-run.ts",
    "ingest": "node --experimental-strip-types scripts/ingest.ts",
    "prune": "node --experimental-strip-types scripts/prune-stale.ts",
    "brands": "node --experimental-strip-types scripts/backfill-brands.ts",
    "rules": "node --experimental-strip-types scripts/backfill-rules.ts",
    "bench:cpu": "node --experimental-strip-types scripts/bench-cpu.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.151.0"
  }
}
